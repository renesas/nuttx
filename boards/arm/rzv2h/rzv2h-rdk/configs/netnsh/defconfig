# Throughput tuning.  32 RX descriptors absorb a TCP burst from the PC at
# 1 Gbit/s; SACK (which selects out-of-order queueing) keeps the segments
# after a lost frame instead of discarding them; delayed ACK halves the
# ACKs sent while receiving; more IOBs back the out-of-order queue and the
# write buffers.  Driver work runs above the iperf threads (100/101).
# RX/TX drop counters are in /proc/net/eth0.  48 KB socket buffers and
# NewReno: with 16 KB, an occasional lost burst could only be recovered by
# the 1.5 s retransmission timer (too few segments in flight for further
# duplicate ACKs), longer than Windows iperf2 waits, which then resets the
# connection (send error 107) or stalls for seconds.  NewReno retransmits
# the next missing segment on each partial ACK.  The 64 KB receive buffer
# lets TCP advertise the full 65535-byte window (no window scaling): with
# 32 KB, TCP PC -> board was capped at ~520 Mbit/s by 32 KB per ~0.5 ms
# round trip.  The IOBs left beside the RX ring (see RX zero copy below) no
# longer hold a full 64 KB window now that TX buffers share DTCM.
CONFIG_RZV2H_GBETH_NTXDESC=8
CONFIG_RZV2H_GBETH_NRXDESC=32
CONFIG_NET_SEND_BUFSIZE=32768
CONFIG_NET_RECV_BUFSIZE=65536
CONFIG_NET_TCP_CC_NEWRENO=y
CONFIG_NET_TCP_DELAYED_ACK=y
CONFIG_NET_TCP_SELECTIVE_ACK=y
CONFIG_SCHED_LPWORKPRIORITY=120
CONFIG_NETDEV_STATISTICS=y

# /proc/cpuload during the Ethernet tests (tests_net_*.yaml)
CONFIG_SCHED_CPULOAD_SYSCLK=y

# No receive packing: with NET_RECV_PACK every queued datagram or segment
# runs iob_pack() over the whole socket read-ahead chain, which re-copies
# up to NET_RECV_BUFSIZE bytes once the reader has consumed the head (UDP
# PC -> board lost 33-61% in the stack).  Full-size frames gain nothing
# from packing; a storm of tiny packets now takes one IOB each.
# CONFIG_NET_RECV_PACK is not set

# RX interrupt coalescing: an interrupt (and a work run) for every 16th RX
# descriptor under load; the RX watchdog (64 x 256 GBETH clocks) signals the
# frames in between, so a lone frame still gets through within ~0.2 ms.  TX:
# a TX interrupt for every 8th frame, a TX doorbell per half TX ring.
CONFIG_RZV2H_GBETH_RX_COAL_FRAMES=16
CONFIG_RZV2H_GBETH_RX_WATCHDOG=64
CONFIG_RZV2H_GBETH_TX_COAL_FRAMES=8

# GBETH RX/TX work on its own queue at the iperf priority (100), at most 16
# frames (within the ~44 datagrams of NET_RECV_BUFSIZE) per run, yielding
# after every run: iperf empties the UDP socket queue per batch, and further
# frames wait in the RX ring instead of being dropped from a full socket
# queue.
CONFIG_RZV2H_GBETH_WQ=y
CONFIG_RZV2H_GBETH_WQ_PRIORITY=100
CONFIG_RZV2H_GBETH_RX_BUDGET=16

# RX zero copy: the GBETH DMA writes each frame straight into an IOB, which
# goes to ipv4_input() as is, and the descriptor gets a fresh IOB.  The IOB
# pool is in DTCM, where the DMA reaches it through the DTCM AXI alias and
# the CPU reads it at TCM speed without cache maintenance (the SRAM version
# spent ~7 us per received frame there).  DTCM holds only the IOBs (the
# unused FSP heap is in SRAM, see the linker script): 75 IOBs of 1552 bytes
# (1536-byte buffer, 16-byte aligned for the DMA) = 114 KB of 128 KB.  32
# sit in the RX ring and 8 are the throttle reserve, so the other 35
# (~53 KB) back the TCP window and write buffers.  The 8 TX buffers and the
# netbuf (13.5 KB) are in DTCM too: no D-cache clean per frame, the DMA reads
# the TX buffers through the AXI alias.  The hot network code runs from ITCM.
CONFIG_RZV2H_GBETH_RX_ZEROCOPY=y
CONFIG_RZV2H_GBETH_TXBUF_DTCM=y
CONFIG_IOB_NBUFFERS=75
CONFIG_IOB_BUFSIZE=1536
CONFIG_IOB_ALIGNMENT=16
CONFIG_IOB_SECTION=".dtcm.gbeth"
CONFIG_RZV2H_ITCM_HOTCODE=y

# D-cache on after the MPU is set up.  The GBETH descriptors stay
# non-cacheable in the .dma MPU region; the IOBs, TX buffers and netbuf are
# in DTCM; everything else (stacks, heap) uses write-back caching.
CONFIG_RZV2H_DCACHE=y

# ARMv7-R assembler memcpy (word and LDM/STM copies).  The generic libc one
# copies byte by byte.  Only memcpy: ARMV7R_STRING_FUNCTION does not build
# (arch_memset.S: missing .fnstart).
CONFIG_ARMV7R_MEMCPY=y

# GBETH inserts the TX checksums and verifies the RX IPv4/TCP/UDP ones; the
# stack skips its software checksum (receive about 40 -> 10 us per frame).
CONFIG_RZV2H_GBETH_CSUM_OFFLOAD=y
