############################################################################
# Renesas HAL (hal_renesas) for all Renesas Arm chips
############################################################################

# The HAL is fetched into this directory when the context target runs.  Chips
# that use it (rzv2h, ...) include this file and then add the include paths
# and sources of the HAL modules they need (see rzv2h/hal.mk).
#
# RENESAS_HAL_URL and RENESAS_HAL_VERSION can be overridden from the
# environment, e.g. RENESAS_HAL_URL=../external/hal_renesas make

RENESAS_HAL_REPO = hal_renesas

# Renesas FSP 4.2.0, branch RAZBSP-1125_Nuttx_Support_RZ_FSP_V420.

ifndef RENESAS_HAL_URL
	RENESAS_HAL_URL = https://gitlab.global.renesas.com/nuttx-dev/hal_renesas.git
endif

ifndef RENESAS_HAL_VERSION
	RENESAS_HAL_VERSION = cf48c5d6cdf34e1aa253626c3f7bcbdfcfe796f2
endif

RENESAS_HAL_DIR = common$(DELIM)renesas$(DELIM)$(RENESAS_HAL_REPO)

STORAGETMP = $(if $(wildcard $(NXTMPDIR)/.*),y,)

ifeq ($(STORAGETMP),y)
define CLONE_RENESAS_HAL_REPO
	$(call CHECK_COMMITSHA,$(NXTMPDIR)/$(RENESAS_HAL_REPO),$(RENESAS_HAL_VERSION))
	$(call CLONE,$(RENESAS_HAL_URL),$(RENESAS_HAL_DIR),$(NXTMPDIR)/$(RENESAS_HAL_REPO))
endef
else
define CLONE_RENESAS_HAL_REPO
	$(call CLONE,$(RENESAS_HAL_URL),$(RENESAS_HAL_DIR))
endef
endif

# Only these paths of the repository are needed (the rest is Zephyr and
# other non NuttX content, and the FSP sources of the other families
# rza, rzg, rzn and rzt).  Non-cone mode is used so that a single family
# below drivers/rz/fsp/src can be selected.
#
# rz[agnt] is a glob matching the RZ families to exclude: rza, rzg, rzn and
# rzt (rzv is the only family kept).

RENESAS_HAL_SPARSE = /nuttx /drivers/rz/fsp/inc /drivers/rz/fsp/src/rzv
RENESAS_HAL_SPARSE += '!/drivers/rz/fsp/inc/instances/rz[agnt]'
RENESAS_HAL_SPARSE += '!/nuttx/rz/portable/rz[agnt]'
RENESAS_HAL_SPARSE += '!/nuttx/rz/rz_cfg/fsp_cfg/rz[agnt]'
RENESAS_HAL_SPARSE += '!/nuttx/rz/rz_cfg/fsp_cfg/bsp/rz[agnt]*'

$(RENESAS_HAL_DIR):
	$(Q) echo "Cloning Renesas HAL"
	$(Q) $(call CLONE_RENESAS_HAL_REPO)
	$(Q) git -C $(RENESAS_HAL_DIR) sparse-checkout set --no-cone $(RENESAS_HAL_SPARSE)
	$(Q) echo "Renesas HAL: $(RENESAS_HAL_VERSION)"
	$(Q) git -C $(RENESAS_HAL_DIR) checkout --quiet $(RENESAS_HAL_VERSION)

# Re-clone when the pinned version is not part of the existing checkout

renesas_hal_check:
	$(Q) $(call CHECK_COMMITSHA,$(RENESAS_HAL_DIR),$(RENESAS_HAL_VERSION))

context:: renesas_hal_check
context:: $(RENESAS_HAL_DIR)

distclean::
	$(call DELDIR, $(RENESAS_HAL_DIR))
