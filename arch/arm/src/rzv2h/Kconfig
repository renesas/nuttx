config RZV2H_QSPI
	bool "QSPI (xSPI) support"
	default n
	---help---
		Enable support for the RZ/V2H xSPI controller in QSPI mode,
		used to talk to a QSPI-capable SPI NOR flash device through
		NuttX's generic QSPI interface (struct qspi_dev_s).  The attached
		flash type, wiring and partitioning are board properties and are
		configured in the board's Kconfig.

menuconfig RZV2H_SCI_I2C
	bool "SCI I2C support"
	default n
	---help---
		Enable the RZ/V2H SCI simple I2C master driver. An SCI channel
		can be used either as a UART or as an I2C master, not both.

if RZV2H_SCI_I2C

config RZV2H_SCI_I2C_TIMEOSEC
	int "SCI I2C timeout (seconds)"
	default 0
	---help---
		Timeout in seconds for I2C transfer completion. Combined with
		RZV2H_SCI_I2C_TIMEOMS to form the total timeout. Set to 0 to
		use only the millisecond component.

config RZV2H_SCI_I2C_TIMEOMS
	int "SCI I2C timeout (milliseconds)"
	default 500
	---help---
		Timeout in milliseconds for I2C transfer completion. Combined
		with RZV2H_SCI_I2C_TIMEOSEC to form the total timeout. Default is
		500 ms.

config RZV2H_SCI_I2C_MERGE_BUFSIZE
	int "SCI I2C message merge stack buffer size (bytes)"
	default 16
	range 1 256
	---help---
		Messages with I2C_M_NOSTART are merged with the previous message
		into a single FSP transfer so that no START or STOP condition is
		generated between them.  Larger merged transfers use a heap
		buffer.

config RZV2H_SCI_I2C_BUS_OFFSET
	int "SCI I2C bus number offset"
	default 10
	range 0 245
	---help---
		The board logic registers SCI channel n as /dev/i2c<offset+n>.
		The default offset of 10 keeps the SCI I2C buses away from the
		RIIC buses (/dev/i2c0 to /dev/i2c8).

config RZV2H_SCI_I2C0
	bool "SCI I2C 0"
	default n
	depends on RZV2H_HAVE_SCI0 && !RZV2H_SCI_UART0

if RZV2H_SCI_I2C0

config RZV2H_SCI_I2C0_BITRATE
	int "SCI0 Bus Bit Rate"
	default 100000
	range 200 400000

config RZV2H_SCI_I2C0_SDA_DELAY
	int "SCI0 SDA output delay (ns)"
	default 300
	range 0 300
	---help---
		Delay of the SDA output relative to the falling edge of SCL.

config RZV2H_SCI_I2C0_NF_CLK
	int "SCI0 noise filter clock select (1-4)"
	default 1
	range 1 4
	---help---
		Digital noise filter sampling clock (CCR1.NFCS): the baud rate
		generator source clock divided by 1, 2, 4 or 8 for values 1 to 4.

config RZV2H_SCI_I2C0_BITRATE_MODULATION
	bool "SCI0 bit rate modulation"
	default y
	---help---
		Use the MDDR bit rate modulation function to reduce the error
		between the requested and the actual bit rate.

config RZV2H_SCI_I2C0_IRQ_PRIORITY
	int "SCI0 I2C interrupt priority"
	range 0 15
	default 12

endif # RZV2H_SCI_I2C0

