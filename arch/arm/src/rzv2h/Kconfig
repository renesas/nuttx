	int "RIIC I2C timeout (seconds)"
	default 0
	---help---
		Timeout in seconds for I2C transfer completion. Combined with
		RZV2H_I2CTIMEOMS to form the total timeout. Set both to 0 to
		use only the millisecond component.

config RZV2H_I2CTIMEOMS
	int "RIIC I2C timeout (milliseconds)"
	default 500
	---help---
		Timeout in milliseconds for I2C transfer completion. Combined
		with RZV2H_I2CTIMEOSEC to form the total timeout. Default is
		500 ms.

