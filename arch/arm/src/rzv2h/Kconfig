	int
	default 0 if RZV2H_SPI_SSLA0_P04 || RZV2H_SPI_SSLA0_P34 || RZV2H_SPI_SSLA0_P93
	default 1 if RZV2H_SPI_SSLA1_P05 || RZV2H_SPI_SSLA1_P35 || RZV2H_SPI_SSLA1_P94
	default 2 if RZV2H_SPI_SSLA2_P14 || RZV2H_SPI_SSLA2_P36 || RZV2H_SPI_SSLA2_P95
	default 3 if RZV2H_SPI_SSLA3_P15 || RZV2H_SPI_SSLA3_P37 || RZV2H_SPI_SSLA3_P96

