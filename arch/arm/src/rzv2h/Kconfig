menu "RZ/V2H Configuration Options"

choice
	prompt "RZ/V2H Core Configuration"
	default ARCH_CHIP_R9A09G057

config ARCH_CHIP_R9A09G057
	bool "RZ/V2H Processor (cortex-r8)"
	select ARCH_CORTEXR8
	select ARCH_HAVE_FPU
	select ARCH_HAVE_THUMB
	select ARCH_HAVE_DPFPU
	select ARMV7R_HAVE_GICv2
	select ARCH_HAVE_MPU
	select ARCH_IRQPRIO
	select RZV2H_HAVE_SCI_B_UART0
	select RZV2H_HAVE_SCI_B_UART1
	select RZV2H_HAVE_SCI_B_UART2
	select RZV2H_HAVE_SCI_B_UART3
	select RZV2H_HAVE_SCI_B_UART4
	select RZV2H_HAVE_SCI_B_UART5
	select RZV2H_HAVE_SCI_B_UART6
	select RZV2H_HAVE_SCI_B_UART7
	select RZV2H_HAVE_SCI_B_UART8
	select RZV2H_HAVE_SCI_B_UART9
	select RZV2H_HAVE_RIIC0
	select RZV2H_HAVE_RIIC1
	select RZV2H_HAVE_RIIC2
	select RZV2H_HAVE_RIIC3
	select RZV2H_HAVE_RIIC4
	select RZV2H_HAVE_RIIC5
	select RZV2H_HAVE_RIIC6
	select RZV2H_HAVE_RIIC7
	select RZV2H_HAVE_RIIC8
	---help---
		RZ/V2H family of Renesas MPUs cortex-r8

endchoice # RZ/V2H Chip Selection

config RZV2H_CORTEXR8_0
	bool "Build for CR8_0 core"
	---help---
		Build for the CR8_0 core of the RZV2H.
		This is the default core for the EVK-RZV2H board.

config RZV2H_GPIO
	bool "GPIO support"
	default y
	depends on DEV_GPIO
	---help---
		Enable support for GPIO pins.

# Peripheral
config RZV2H_SCI_B
	bool
	default n

