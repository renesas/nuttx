menu "Flexible Data (FD)"
	depends on RZV2H_CANFD

choice
	prompt "Protocol Exceptions"
	default RZV2H_CANFD_FD_PROTOCOL_EXCEPTION_ISO
	---help---
		Select whether to enter the protocol exception handling
		state when a RES bit is sampled recessive as defined in
		ISO 11898-1, or to send an error frame (CFDGFDCFG.RPED).

config RZV2H_CANFD_FD_PROTOCOL_EXCEPTION_ISO
	bool "ISO 11898-1"

config RZV2H_CANFD_FD_PROTOCOL_EXCEPTION
	bool "Send error frame"

endchoice # Protocol Exceptions

config RZV2H_CANFD_FD_OVERFLOW
	bool "Payload Overflow Reject"
	default y
	---help---
		When enabled, received messages larger than the destination
		buffer are rejected. When disabled, they are truncated.

endmenu # Flexible Data (FD)

