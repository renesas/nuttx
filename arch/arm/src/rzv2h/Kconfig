config RZV2H_UBOOT_IMAGE
	bool "Generate split CR8_0 U-Boot images"
	default n
	depends on RZV2H_CORTEXR8_0
	---help---
		Link the low-vector table at its ITCM run address, with its load copy
		at the start of RCPU SRAM, and generate the raw image nuttx_uboot.bin
		(the table's load copy, code and data) after linking.  U-Boot loads
		it at CONFIG_RAM_START.  CR8_0 takes its reset vector from ITCM, so
		U-Boot also writes a two-word trampoline into ITCM through its AXI
		alias before releasing CR8_0 from reset:

		  mw.l 0x12040000 0xe51ff004   (ldr pc, [pc, #-4])
		  mw.l 0x12040004 0x08180000   (start of nuttx_uboot.bin)

		NuttX replaces the trampoline with the full vector table at boot.

		Leave this disabled for debugger loading.  In that layout the vector
		table is linked into SRAM and copied to ITCM by the NuttX startup
		code after the debugger enters the firmware at __start.

menuconfig RZV2H_RPTUN
	bool "OpenAMP RPTUN support"
	default n
	depends on RZV2H_CORTEXR8_0
	depends on ARM_MPU && ARM_MPU_NREGIONS >= 8
	select DEV_SIMPLE_ADDRENV
	select RPTUN
	select SCHED_HPWORK
	---help---
		Enable the RZ/V2H RPTUN lower half for communication between
		Linux on the Cortex-A55 and NuttX on Cortex-R8 core 0.  The
		transport uses an FSP MHU_B_NS instance supplied by the board.

if RZV2H_RPTUN

choice
	prompt "RPMsg channel"
	default RZV2H_RPTUN_CHANNEL0
	---help---
		Select the Multi-OS RPMsg channel owned by the NuttX RPTUN
		device.  Both shared resource-table entries are initialized so
		the Linux sample can inspect both, but one channel is active in
		NuttX at a time.

config RZV2H_RPTUN_CHANNEL0
	bool "Channel 0"

config RZV2H_RPTUN_CHANNEL1
	bool "Channel 1"

endchoice

config RZV2H_RPTUN_ECHO
	bool "Multi-OS RPMsg echo service"
	default y
	---help---
		Create the endpoint for the selected channel used by the Renesas RZ
		Multi-OS Package Linux rpmsg-sample application. The endpoint
		echoes ordinary payloads and recognizes the reference
		application's shutdown word.

endif # RZV2H_RPTUN

