config RZV2H_SPI_CHANNEL_1
	bool "SPI_B channel 1"
	default n
	---help---
		Enable the SPI_B channel 1 lower-half instance.  The board must
		configure the channel pins and provide its chip-select callbacks.

if RZV2H_SPI_CHANNEL_1

config RZV2H_SPI1_TXI_INTSEL
	int "SPI_B TXI interrupt-select (SEL) IRQ number"
	default 426
	range 353 479

config RZV2H_SPI1_RXI_INTSEL
	int "SPI_B RXI interrupt-select (SEL) IRQ number"
	default 425
	range 353 479

config RZV2H_SPI_CHANNEL_1_FREQUENCY
	int "SPI_B channel 1 initial frequency (Hz)"
	range 1 1000000000
	default 1000000
	---help---
		Set the initial SPI_B channel 1 master frequency.  The NuttX
		SPI_SETFREQUENCY interface can change it after initialization.
		FSP limits the achievable frequency according to the selected
		SPI_B source clock and divider range.  In slave mode the external
		master supplies the clock, so this setting is not used.

config RZV2H_SPI_CHANNEL_1_NBITS
	int "SPI_B channel 1 initial bits per word"
	range 4 32
	default 8
	---help---
		Set the initial number of bits in each SPI_B channel 1 master word.
		The NuttX SPI_SETBITS interface can change it after initialization.
		A slave device supplies its width to bind() instead.

choice
	prompt "SPI_B channel 1 clock polarity"
	default RZV2H_SPI_CHANNEL_1_CPOL_LOW
	---help---
		Initial master clock polarity.  A slave device supplies its mode
		to bind() instead.

config RZV2H_SPI_CHANNEL_1_CPOL_LOW
	bool "CPOL=0 (clock low when idle)"

config RZV2H_SPI_CHANNEL_1_CPOL_HIGH
	bool "CPOL=1 (clock high when idle)"

endchoice

choice
	prompt "SPI_B channel 1 clock phase"
	default RZV2H_SPI_CHANNEL_1_CPHA_ODD
	---help---
		Initial master clock phase.  A slave device supplies its mode to
		bind() instead.

config RZV2H_SPI_CHANNEL_1_CPHA_ODD
	bool "CPHA=0 (sample on first/odd edge)"

config RZV2H_SPI_CHANNEL_1_CPHA_EVEN
	bool "CPHA=1 (sample on second/even edge)"

endchoice

config RZV2H_SPI_CHANNEL_1_INITIAL_MODE
	int
	default 0 if RZV2H_SPI_CHANNEL_1_CPOL_LOW && RZV2H_SPI_CHANNEL_1_CPHA_ODD
	default 1 if RZV2H_SPI_CHANNEL_1_CPOL_LOW && RZV2H_SPI_CHANNEL_1_CPHA_EVEN
	default 2 if RZV2H_SPI_CHANNEL_1_CPOL_HIGH && RZV2H_SPI_CHANNEL_1_CPHA_ODD
	default 3 if RZV2H_SPI_CHANNEL_1_CPOL_HIGH && RZV2H_SPI_CHANNEL_1_CPHA_EVEN

choice
	prompt "SPI_B channel 1 operating mode"
	default RZV2H_SPI_CHANNEL_1_MASTER

config RZV2H_SPI_CHANNEL_1_MASTER
	bool "Master"

config RZV2H_SPI_CHANNEL_1_SLAVE
	bool "Slave"
	depends on SPI_SLAVE
	---help---
		Expose this channel through the NuttX struct spi_slave_ctrlr_s
		interface.  Enable SPI_SLAVE_DRIVER to register /dev/spislv1 for
		application-level testing.

endchoice

choice
	prompt "SPI_B channel 1 wire mode"
	default RZV2H_SPI_CHANNEL_1_3WIRE

config RZV2H_SPI_CHANNEL_1_3WIRE
	bool "3-wire clock-synchronous (no SSL)"
	---help---
		Use the FSP clock-synchronous method.  Transfers use MOSI, MISO,
		and RSPCK; the SPI_B peripheral does not use SSL for framing.

config RZV2H_SPI_CHANNEL_1_4WIRE
	bool "4-wire SPI (uses SSL)"
	---help---
		Use the FSP SPI method.  Transfers use MOSI, MISO, RSPCK, and
		SSL.  The board routes the selected SSL pin to the SPI_B
		peripheral output in master mode or input in slave mode.

endchoice

choice
	prompt "SPI_B channel 1 SSL pin"
	default RZV2H_SPI_SSLB0_PA4
	---help---
		Select the SSL signal and physical pin used as the channel 1
		chip select.  In 4-wire mode it is a native SPI_B output for a
		master or input for a slave.  3-wire mode does not configure or
		use it.

config RZV2H_SPI_SSLB0_P34
	bool "SSLB0 on P3.4"

config RZV2H_SPI_SSLB0_PA4
	bool "SSLB0 on PA.4"

config RZV2H_SPI_SSLB1_P36
	bool "SSLB1 on P3.6"

config RZV2H_SPI_SSLB1_PA5
	bool "SSLB1 on PA.5"

config RZV2H_SPI_SSLB2_P04
	bool "SSLB2 on P0.4"

config RZV2H_SPI_SSLB2_PA6
	bool "SSLB2 on PA.6"

config RZV2H_SPI_SSLB3_P14
	bool "SSLB3 on P1.4"

config RZV2H_SPI_SSLB3_PA7
	bool "SSLB3 on PA.7"

endchoice

config RZV2H_SPI_CHANNEL_1_SSL
	int
	default 0 if RZV2H_SPI_SSLB0_P34 || RZV2H_SPI_SSLB0_PA4
	default 1 if RZV2H_SPI_SSLB1_P36 || RZV2H_SPI_SSLB1_PA5
	default 2 if RZV2H_SPI_SSLB2_P04 || RZV2H_SPI_SSLB2_PA6
	default 3 if RZV2H_SPI_SSLB3_P14 || RZV2H_SPI_SSLB3_PA7

