menuconfig RZV2H_RIIC_I2C
	bool "RIIC I2C support"
	default n
	---help---
		Enable the RZ/V2H RIIC I2C driver. Select this option to
		configure the individual RIIC I2C channels.

if RZV2H_RIIC_I2C

config RZV2H_RIIC_I2C_TIMEOSEC
	int "RIIC I2C timeout (seconds)"
	default 0
	---help---
		Timeout in seconds for I2C transfer completion. Combined with
		RZV2H_RIIC_I2C_TIMEOMS to form the total timeout. Set to 0 to
		use only the millisecond component.

config RZV2H_RIIC_I2C_TIMEOMS
	int "RIIC I2C timeout (milliseconds)"
	default 500
	---help---
		Timeout in milliseconds for I2C transfer completion. Combined
		with RZV2H_RIIC_I2C_TIMEOSEC to form the total timeout. Default is
		500 ms.

config RZV2H_RIIC_I2C_MERGE_BUFSIZE
	int "RIIC I2C message merge stack buffer size (bytes)"
	default 16
	range 1 256
	---help---
		Consecutive messages with the same direction are merged into a
		single FSP transfer so that no START or STOP condition is
		generated between them.  Merged transfers larger than this
		buffer fail with -ENOMEM.

config RZV2H_RIIC0
	bool "RIIC 0"
	default n
	depends on RZV2H_HAVE_RIIC0

if RZV2H_RIIC0

config RZV2H_RIIC0_BITRATE
	int "RIIC0 Bus Bit Rate"
	default 400000

config RZV2H_RIIC0_SCL_RISE_TIME
	int "RIIC0 SCL Rise Time (ns)"
	default 120

config RZV2H_RIIC0_SCL_FALL_TIME
	int "RIIC0 SCL Fall Time (ns)"
	default 120

config RZV2H_RIIC0_SCL_DUTY_CYCLE
	int "RIIC0 SCL Duty Cycle (%)"
	default 50

config RZV2H_RIIC0_NF_STAGE
	int "RIIC0 Noise Filter Stages"
	default 1
	range 1 4

config RZV2H_RIIC0_TXI_INTSEL
	int "RIIC0 TXI interrupt-select (SEL) IRQ number"
	default 447
	range 353 479

config RZV2H_RIIC0_RXI_INTSEL
	int "RIIC0 RXI interrupt-select (SEL) IRQ number"
	default 446
	range 353 479

config RZV2H_RIIC0_IRQ_PRIORITY
	int "RIIC0 interrupt priority"
	range 0 15
	default 12

endif #RZV2H_RIIC0

