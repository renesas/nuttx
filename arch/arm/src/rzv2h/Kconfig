menuconfig RZV2H_UART_SCI
	bool "SCI UART support"
	default y
	select RZV2H_SCI
	select ARCH_HAVE_SERIAL_TERMIOS
	---help---
		Enable the RZ/V2H SCI UART driver. Select this option to
		configure the individual SCI UART channels.

if RZV2H_UART_SCI

config RZV2H_SCI_IRQ_PRIORITY
	int "SCI interrupt priority"
	range 0 15
	default 12
	---help---
		Set the GIC interrupt priority used by all enabled SCI UART
		channels. Zero is the highest priority and 15 is the lowest.

menu "SCI UART optional features"

config RZV2H_SCI_FLOW_CONTROL
	bool "Flow control support (not implemented)"
	default n
	---help---
		Configuration support for SCI CTS/RTS hardware flow
		control.

config RZV2H_SCI_DMA
	bool "DMA transfer support (not implemented)"
	default n
	---help---
		Configuration support for SCI DMA transfers.

config RZV2H_SCI_FIFO
	bool "FIFO support (not implemented)"
	default n
	---help---
		Configuration support for SCI hardware FIFOs.

endmenu # "SCI UART optional features"

