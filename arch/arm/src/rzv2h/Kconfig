	bool "ANI002"
	default n
	---help---
		Include dedicated analog input ANI002 in ADC0 group-A scans.

config RZV2H_ADC0_ANI003
	bool "ANI003"
	default n
	---help---
		Include dedicated analog input ANI003 in ADC0 group-A scans.

