	bool "ANI007"
	default n
	---help---
		Include dedicated analog input ANI007 in ADC0 group-A scans.

endmenu # "ADC0 channel selection"

choice
	prompt "ADC resolution"
	default RZV2H_ADC_RESOLUTION_12BIT

config RZV2H_ADC_RESOLUTION_12BIT
	bool "12-bit"
	---help---
		Use 12-bit conversion results with a range of 0 to 4095.

config RZV2H_ADC_RESOLUTION_8BIT
	bool "8-bit"
	---help---
		Use 8-bit conversion results with a range of 0 to 255.

endchoice # "ADC resolution"

config RZV2H_ADC_WINDOW_A
	bool "Enable Window A comparison"
	default n
	---help---
		Enable the ADC-E Window A hardware comparator and its interrupt.
		Every channel enabled in the ADC0 channel selection menu is compared
		using the same lower limit, upper limit, and comparison condition.

if RZV2H_ADC_WINDOW_A

choice
	prompt "Window A comparison condition"
	default RZV2H_ADC_WINDOW_A_OUTSIDE

config RZV2H_ADC_WINDOW_A_OUTSIDE
	bool "Outside window"
	---help---
		Generate a Window A event when a selected channel result is outside
		the configured lower-to-upper window.

config RZV2H_ADC_WINDOW_A_INSIDE
	bool "Inside window"
	---help---
		Generate a Window A event when a selected channel result is inside
		the configured lower-to-upper window.

endchoice # "Window A comparison condition"

config RZV2H_ADC_WINDOW_A_LOWER
	int "Window A lower threshold"
	range 0 65535
	default 1024 if RZV2H_ADC_RESOLUTION_12BIT
	default 64 if RZV2H_ADC_RESOLUTION_8BIT
	---help---
		Set the 16-bit Window A lower threshold register value.

config RZV2H_ADC_WINDOW_A_UPPER
	int "Window A upper threshold"
	range 0 65535
	default 3072 if RZV2H_ADC_RESOLUTION_12BIT
	default 192 if RZV2H_ADC_RESOLUTION_8BIT
	---help---
		Set the 16-bit Window A upper threshold register value. This
		value must be greater than or equal to the lower threshold.

config RZV2H_ADC_WINDOW_A_IRQ_PRIORITY
	int "Window A interrupt priority"
	range 0 15
	default 12
	---help---
		Set the GIC priority used by the ADC-E Window A compare interrupt.

endif # RZV2H_ADC_WINDOW_A

choice
	prompt "ADC add/average count"
	default RZV2H_ADC_ADD_AVERAGE_OFF

config RZV2H_ADC_ADD_AVERAGE_OFF
	bool "Disabled"
	---help---
		Return one conversion result for each enabled channel.

config RZV2H_ADC_ADD_TWO
	bool "Add 2 conversions"
	---help---
		Return the sum of two conversions for every enabled channel.

config RZV2H_ADC_ADD_THREE
	bool "Add 3 conversions"
	---help---
		Return the sum of three conversions for every enabled channel.

config RZV2H_ADC_ADD_FOUR
	bool "Add 4 conversions"
	---help---
		Return the sum of four conversions for every enabled channel.

config RZV2H_ADC_ADD_SIXTEEN
	bool "Add 16 conversions"
	---help---
		Return the sum of sixteen conversions for every enabled channel.

config RZV2H_ADC_AVERAGE_TWO
	bool "Average 2 conversions"
	---help---
		Return the average of two conversions for every enabled channel.
		The result retains the configured 8-bit or 12-bit ADC range.

config RZV2H_ADC_AVERAGE_FOUR
	bool "Average 4 conversions"
	---help---
		Return the average of four conversions for every enabled channel.
		The result retains the configured 8-bit or 12-bit ADC range.

endchoice # "ADC add/average count"

config RZV2H_ADC_CLEAR_AFTER_READ
	bool "Clear ADC result after read"
	default n
	---help---
		Enable the ADC-E clear-after-read function. When enabled, hardware
		clears a channel's result register after the driver reads it.

		Leave this disabled if the most recent conversion result must remain
		available for repeated reads. This option does not change the NuttX
		ADC upper-half FIFO contents after a sample has been delivered.

config RZV2H_ADC_SCAN_END_INTERRUPT
	bool "Use scan-end interrupt"
	default n
	---help---
		Deliver completed scans through the ADC-E group-A scan-end
		interrupt. If disabled, ANIOC_TRIGGER polls for scan completion.

config RZV2H_ADC_SCAN_END_INTSEL
	int "ADC scan-end interrupt-select (SEL) IRQ number"
	default 429
	range 353 479
	depends on RZV2H_ADC_SCAN_END_INTERRUPT
	---help---
		Select the FSP IRQ number for the SEL. Values 353 through 479
		correspond to SEL0 through SEL126.

config RZV2H_ADC_SCAN_END_IRQ_PRIORITY
	int "ADC scan-end interrupt priority"
	range 0 15
	default 12
	depends on RZV2H_ADC_SCAN_END_INTERRUPT
	---help---
		Set the GIC priority used by the ADC-E group-A scan-end
		interrupt. Zero is the highest priority and 15 is the lowest.

choice
	prompt "ADC trigger source"
	default RZV2H_ADC_TRIGGER_SOFTWARE

config RZV2H_ADC_TRIGGER_SOFTWARE
	bool "Software trigger"
	---help---
		ANIOC_TRIGGER starts one ADC scan immediately.

config RZV2H_ADC_TRIGGER_EXTERNAL
	bool "External ADTRG hardware trigger"
	depends on RZV2H_ADC_SCAN_END_INTERRUPT
	---help---
		Enable the ADC external trigger input. A subsequent external
		ADTRG event starts the conversion.

endchoice # "ADC trigger source"

comment "ELC are not supported"

endif # RZV2H_ADC

menuconfig RZV2H_SPI_B
	bool "SPI_B support"
	default n
	select SPI
	---help---
		Enable the NuttX SPI lower-half driver for the RZ/V2H SPI_B
		controller using the Renesas FSP r_spi_b API.

		The FSP hardware role can be selected independently for each SPI_B
		channel.  Master channels use the standard NuttX SPI interface;
		slave channels use the NuttX SPI slave-controller interface.  Pin
		multiplexing, chip-select handling, and device registration are
		provided by the board logic.

if RZV2H_SPI_B

config RZV2H_SPI_B_IRQ_PRIORITY
	int "SPI_B interrupt priority"
	range 0 15
	default 12
	---help---
		Set the GIC interrupt priority used by the RXI, TXI, transfer-end,
		and error interrupts of all enabled SPI_B channels.  Zero is the
		highest priority and 15 is the lowest.

config RZV2H_SPI_SLAVE_BUFFER_SIZE
	int "SPI_B slave transfer buffer size (words)"
	default 128
	range 1 4096
	depends on SPI_SLAVE
	---help---
		Number of words copied into the controller's transmit and receive
		buffers for each SPI_B slave channel.  FSP requires a known transfer
		length before the master supplies the clock, so one NuttX slave
		enqueue operation is limited to this number of words.

config RZV2H_SPI_SLAVE_DEFAULT_NWORDS
	int "SPI_B slave listen transfer size (words)"
	default 4
	range 1 RZV2H_SPI_SLAVE_BUFFER_SIZE
	depends on SPI_SLAVE
	---help---
		Number of words armed when a slave device polls for received data
		without first enqueueing transmit data.  The external master must
		clock exactly this number of words because the FSP SPI_B API requires
		the transfer length before the transfer starts.

config RZV2H_SPI_CHANNEL_0
	bool "SPI_B channel 0"
	default n
	---help---
		Enable the SPI_B channel 0 lower-half instance.  The board must
		configure the channel pins and provide its chip-select callbacks.

if RZV2H_SPI_CHANNEL_0

config RZV2H_SPI0_TXI_INTSEL
	int "SPI_B TXI interrupt-select (SEL) IRQ number"
	default 428
	range 353 479

config RZV2H_SPI0_RXI_INTSEL
	int "SPI_B RXI interrupt-select (SEL) IRQ number"
	default 427
	range 353 479

config RZV2H_SPI_CHANNEL_0_FREQUENCY
	int "SPI_B channel 0 initial frequency (Hz)"
	range 1 1000000000
	default 1000000
	---help---
		Set the initial SPI_B channel 0 master frequency.  The NuttX
		SPI_SETFREQUENCY interface can change it after initialization.
		FSP limits the achievable frequency according to the selected
		SPI_B source clock and divider range.  In slave mode the external
		master supplies the clock, so this setting is not used.

config RZV2H_SPI_CHANNEL_0_NBITS
	int "SPI_B channel 0 initial bits per word"
	range 4 32
	default 8
	---help---
		Set the initial number of bits in each SPI_B channel 0 master word.
		The NuttX SPI_SETBITS interface can change it after initialization.
		A slave device supplies its width to bind() instead.

choice
	prompt "SPI_B channel 0 clock polarity"
	default RZV2H_SPI_CHANNEL_0_CPOL_LOW
	---help---
		Initial master clock polarity.  A slave device supplies its mode
		to bind() instead.

config RZV2H_SPI_CHANNEL_0_CPOL_LOW
	bool "CPOL=0 (clock low when idle)"

config RZV2H_SPI_CHANNEL_0_CPOL_HIGH
	bool "CPOL=1 (clock high when idle)"

endchoice

choice
	prompt "SPI_B channel 0 clock phase"
	default RZV2H_SPI_CHANNEL_0_CPHA_ODD
	---help---
		Initial master clock phase.  A slave device supplies its mode to
		bind() instead.

config RZV2H_SPI_CHANNEL_0_CPHA_ODD
	bool "CPHA=0 (sample on first/odd edge)"

config RZV2H_SPI_CHANNEL_0_CPHA_EVEN
	bool "CPHA=1 (sample on second/even edge)"

endchoice

config RZV2H_SPI_CHANNEL_0_INITIAL_MODE
	int
	default 0 if RZV2H_SPI_CHANNEL_0_CPOL_LOW && RZV2H_SPI_CHANNEL_0_CPHA_ODD
	default 1 if RZV2H_SPI_CHANNEL_0_CPOL_LOW && RZV2H_SPI_CHANNEL_0_CPHA_EVEN
	default 2 if RZV2H_SPI_CHANNEL_0_CPOL_HIGH && RZV2H_SPI_CHANNEL_0_CPHA_ODD
	default 3 if RZV2H_SPI_CHANNEL_0_CPOL_HIGH && RZV2H_SPI_CHANNEL_0_CPHA_EVEN

choice
	prompt "SPI_B channel 0 operating mode"
	default RZV2H_SPI_CHANNEL_0_MASTER

config RZV2H_SPI_CHANNEL_0_MASTER
	bool "Master"

config RZV2H_SPI_CHANNEL_0_SLAVE
	bool "Slave"
	depends on SPI_SLAVE
	---help---
		Expose this channel through the NuttX struct spi_slave_ctrlr_s
		interface.  Enable SPI_SLAVE_DRIVER to register /dev/spislv0 for
		application-level testing.

endchoice

choice
	prompt "SPI_B channel 0 wire mode"
	default RZV2H_SPI_CHANNEL_0_3WIRE

config RZV2H_SPI_CHANNEL_0_3WIRE
	bool "3-wire clock-synchronous (no SSL)"
	---help---
		Use the FSP clock-synchronous method.  Transfers use MOSI, MISO,
		and RSPCK; the SPI_B peripheral does not use SSL for framing.

config RZV2H_SPI_CHANNEL_0_4WIRE
	bool "4-wire SPI (uses SSL)"
	---help---
		Use the FSP SPI method.  Transfers use MOSI, MISO, RSPCK, and
		SSL.  The board routes the selected SSL pin to the SPI_B
		peripheral output in master mode or input in slave mode.

endchoice

endif # RZV2H_SPI_CHANNEL_0

