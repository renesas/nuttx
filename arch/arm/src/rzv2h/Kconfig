menuconfig RZV2H_UART_SCI
	bool "SCI-B UART support"
	default y
	select RZV2H_SCI_B
	select ARCH_HAVE_SERIAL_TERMIOS
	---help---
		Enable the RZ/V2H SCI-B UART driver. Select this option to
		configure the individual SCI-B UART channels.

if RZV2H_UART_SCI

config RZV2H_SCI_B_IRQ_PRIORITY
	int "SCI-B interrupt priority"
	range 0 15
	default 12
	---help---
		Set the GIC interrupt priority used by all enabled SCI-B UART
		channels. Zero is the highest priority and 15 is the lowest.

menu "SCI-B UART optional features"

config RZV2H_SCI_B_FLOW_CONTROL
	bool "Flow control support (not implemented)"
	default n
	---help---
		Configuration support for SCI-B CTS/RTS hardware flow
		control.

config RZV2H_SCI_B_DMA
	bool "DMA transfer support (not implemented)"
	default n
	---help---
		Configuration support for SCI-B DMA transfers.

config RZV2H_SCI_B_FIFO
	bool "FIFO support (not implemented)"
	default n
	---help---
		Configuration support for SCI-B hardware FIFOs.

endmenu # "SCI-B UART optional features"

