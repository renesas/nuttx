# External hal renesas
HAL_EXDIR := $(TOPDIR)$(DELIM)..$(DELIM)external$(DELIM)hal_renesas
HAL_DRIVER_EXDIR := $(HAL_EXDIR)$(DELIM)drivers
HAL_NUTTX_EXDIR := $(HAL_EXDIR)$(DELIM)nuttx

# Hal renesas in the arch tree
HAL_INNDIR := $(TOPDIR)$(DELIM)arch$(DELIM)arm$(DELIM)src$(DELIM)rzv2h$(DELIM)hal_renesas
HAL_DRIVER_INNDIR := $(HAL_INNDIR)$(DELIM)drivers
HAL_NUTTX_INNDIR := $(HAL_INNDIR)$(DELIM)nuttx

# Tool copy
TOOL_CP :=$(TOPDIR)$(DELIM)tools$(DELIM)copydir.sh

# Remove Renesas HAL
distclean::
	@rm -rf "$(HAL_INNDIR)"

# Copy Renesas HAL
hal_cp:
	@echo "[INFOR]: Copy Renesas HAL into arch tree"
	@rm -rf "$(HAL_INNDIR)"
	@mkdir -p "$(HAL_INNDIR)"
	@$(TOOL_CP) "$(HAL_DRIVER_EXDIR)" "$(HAL_DRIVER_INNDIR)"
	@$(TOOL_CP) "$(HAL_NUTTX_EXDIR)" "$(HAL_NUTTX_INNDIR)"

context:: hal_cp

include chip/hal.mk
CFLAGS += $(INCLUDES)
CFLAGS += -Wno-undef

ifeq ($(CONFIG_ARCH_ARMV7R),y)
include armv7-r/Make.defs
endif

# rzv2h-specific C source files
CHIP_CSRCS += rzv2h_start.c rzv2h_irq.c rzv2h_timerisr.c rzv2h_lowputc.c rzv2h_clockconfig.c rzv2h_mpu_region.c rzv2h_fsp_err.c

ifeq ($(CONFIG_RZV2H_SCI_B),y)
CHIP_CSRCS += rzv2h_serial.c
endif

ifeq ($(CONFIG_DEV_GPIO),y)
CHIP_CSRCS += rzv2h_gpio.c
endif

ifeq ($(CONFIG_RZV2H_SPI_B),y)
CHIP_CSRCS += rzv2h_spi.c
endif

ifeq ($(CONFIG_RZV2H_I2C),y)
CHIP_CSRCS += rzv2h_i2c.c
endif

ifeq ($(CONFIG_RZV2H_RTC),y)
CHIP_CSRCS += rzv2h_rtc.c
endif

ifeq ($(CONFIG_RZV2H_GPT_PWM),y)
CHIP_CSRCS += rzv2h_pwm.c
endif
